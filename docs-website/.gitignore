# The repository root .gitignore has a bare `*.mdx` rule, which would otherwise
# swallow every page in content/.
!*.mdx

# The root's `lib/` rule, meant for package build output, would also ignore the
# site's source in src/lib/.
!/src/lib/

# deps
/node_modules

# generated content
.source
/content/api

# build
/.next/
/out/
/build
*.tsbuildinfo

# misc
.DS_Store
npm-debug.log*

# others
.env*.local
.vercel
next-env.d.ts
.env*
