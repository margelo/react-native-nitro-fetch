{
  "name": "docs-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:api && fumadocs-mdx && next dev",
    "build": "bun run docs:api && next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "docs:api": "typedoc --options typedoc.config.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.2",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@r4ai/remark-callout": "^0.6.2",
    "fumadocs-core": "^16.15.12",
    "fumadocs-docgen": "^3.1.1",
    "fumadocs-mdx": "^15.4.3",
    "fumadocs-typescript": "^5.4.1",
    "fumadocs-ui": "^16.15.12",
    "next": "16",
    "react": "19",
    "react-dom": "19",
    "refractor": "^5.0.0",
    "rehype-prism-plus": "^2.0.2"
  }
}
